NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EMAIL_REDIRECT_URL=http://localhost:5173/login
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
LOG_LEVEL=debug
# Servicio de IA (noto-ai-server)
NOTO_AI_URL=http://localhost:8000
NOTO_AI_TIMEOUT_MS=3600000
GENERATION_MAX_FILE_SIZE_MB=1536
GENERATION_MAX_DURATION_SEC=7200
# Carpeta de audios en proceso / para reintentar (vacío = <tmp del sistema>/noto-uploads)
# GENERATION_TMP_DIR=
GENERATION_NORMALIZE_ABOVE_MB=25
GENERATION_RETENTION_HOURS=24
HTTP_REQUEST_TIMEOUT_MS=3600000
